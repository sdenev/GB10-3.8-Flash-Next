# ---------------------------------------------------------------------------
#  Optional overrides for setup.sh and start.sh.
#
#  To use:  cp .env.sample .env      (.env is gitignored; this sample is what
#                                     gets committed)
#
#  Precedence, highest first:
#    1. shell env already exported when you run the script
#    2. values in ./.env
#    3. the script's own defaults
#
#  Every RUNTIME knob below defaults to the UPSTREAM value, so an empty .env
#  reproduces stock install-3.8flash.sh behaviour. Uncomment only what you
#  want to change.
#
#  The suggested values are what one GB10 box converged on; see LOG.md for the
#  measurements behind them. Your hardware will differ -- treat them as a
#  starting point, not settings to copy blind.
#
#  NOTE: no secrets belong here. HF_TOKEN is read from your shell environment
#  by setup.sh; do not add it to this file or to .env.
# ---------------------------------------------------------------------------


# ---- runtime: read by start.sh on every launch ----------------------------

# Serving mode.
#   1 = HashK R=4 n-gram table   (default; keeps the n-gram memory)
#   2 = PLE off                  (frees the 12.8 GB table for the KV pool and
#                                 raises the context setting, at some quality
#                                 cost -- upstream measures ~2 pts on
#                                 tool-eval-bench. It is a boot flag, so it is
#                                 reversible; see LOG.md §6.)
#MODE=1

# Concurrent requests admitted; extra requests queue rather than fail.
# Note this is not the only limit: admission also reserves 5 mamba slots per
# request, so the effective cap is min(MAX_RUNNING, MAMBA_CACHE / 5).
# Lowering it frees memory that goes to the KV pool. Single-request latency is
# unaffected; only peak aggregate throughput drops. See LOG.md §2, §3.
#MAX_RUNNING=2

# Mamba (Gated DeltaNet) state slots. Each holds one request's recurrent state
# at a fixed size -- independent of context length -- so slots provisioned for
# concurrency you do not use are dead weight, and freeing them grows the KV
# pool almost 1:1.
# Keep MAMBA_CACHE >= MAX_RUNNING * 5, with slack: sitting exactly on the
# boundary risks admitting one request fewer. Slots also back mamba prefix
# caching between turns, so do not cut them to the bone. See LOG.md §3.
#MAMBA_CACHE=12

# Context length. LEAVE UNSET unless you know why you are changing it.
# The real ceiling is the KV pool, not this value: the server rejects input
# above the pool size while /v1/models advertises max_model_len = this value.
# Lowering it does NOT reconcile the two -- context_len also feeds pool sizing,
# so the pool shrinks with it. Configure your client's context window instead.
# Unset, the launcher picks a per-mode default. See LOG.md §4.
#CTX=

# Reasoning effort: off | low | medium | xhigh
#THINKING=medium

#PORT=30000

# Fraction of memory claimed as the static budget. The remainder is NOT waste:
# it is the reserve for activations and CUDA graphs, and the launcher warns
# that launching short can hard-lock the machine rather than failing cleanly.
# Raising it is the last lever on pool size; step it and verify at each step.
#MEM_FRACTION=0.90


# ---- setup-time: read by setup.sh, then BAKED into ~/launch-3.8flash.sh ----
# Changing these needs a re-run of ./setup.sh, not just a restart.

# Where the checkpoint and the HashK artifact live. Both default to inside the
# repo (and are gitignored) rather than the shared ~/.cache/huggingface, so a
# checkout is self-contained and `./uninstall.sh --all` can reclaim it.
# Point them at a shared cache if you would rather share the checkpoint.
#HF_HOME=/path/to/repo/.cache/huggingface
#WORK=/path/to/repo/.work
